# Copy this file to .env (same folder) and fill in the values.
# Never commit or share the real .env — the token controls the bot.

# Token from @BotFather (Telegram: /newbot)
BRAND_BOT_TOKEN=123456:ABC-your-token-here

# Comma-separated Telegram user ids allowed to use the bot.
# Don't know yours? Start the bot, send /id to it, and paste the number here.
# Leave this empty and nobody is allowed — the bot answers /id and nothing else.
BRAND_ALLOWED_USER_IDS=

# Optional overrides (defaults shown):
# BRAND_REPO_ROOT=..                  # path to the brand workspace folder (auto-detected)
# BRAND_TZ=Africa/Tunis               # any IANA zone, e.g. Europe/Berlin
# BRAND_REMINDER_TIME=08:00           # daily morning briefing; "off" to disable
# BRAND_DRAFT_REMINDER_TIME=21:00     # nightly "is tomorrow drafted?" check; "off" to disable
# BRAND_GIT_SYNC_INTERVAL=120         # seconds between git pulls; "off" to disable
